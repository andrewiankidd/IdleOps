<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Multi-target: the Windows TFM links WinRT OCR (shared.win) in-process with a
         warm engine; the net10.0 TFM uses Tesseract + xdotool via the shared
         ImageTextFinder/IScreenCapturer/IWindowLocator, so playbk orchestrates the
         (now cross-platform) tools on Linux too. -->
    <TargetFrameworks>net10.0-windows10.0.22621.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="playbk.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="15.3.0" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\shared.csproj" />
    <!-- WinRT OCR is Windows-only; reference it only for the Windows TFM. -->
    <ProjectReference Include="..\shared.win\shared.win.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0-windows10.0.22621.0'" />
    <ProjectReference Include="..\outcap\outcap.csproj" />
    <ProjectReference Include="..\inpctl\inpctl.csproj" />
    <ProjectReference Include="..\uiactl\uiactl.csproj" />
    <ProjectReference Include="..\llmctl\llmctl.csproj" />
  </ItemGroup>

  <!-- txtfnd/waitfr/spkbak are multi-targeted: copy their Windows-TFM output when
       playbk builds its Windows TFM, and their net10.0 output on Linux/macOS. -->
  <PropertyGroup>
    <SiblingWinTfm>net10.0-windows10.0.22621.0</SiblingWinTfm>
    <SiblingTfm Condition="'$(TargetFramework)' == 'net10.0-windows10.0.22621.0'">$(SiblingWinTfm)</SiblingTfm>
    <SiblingTfm Condition="'$(SiblingTfm)' == ''">net10.0</SiblingTfm>

    <OutcapBinDir>$(MSBuildThisFileDirectory)..\outcap\bin\$(Configuration)\net10.0\</OutcapBinDir>
    <InpctlBinDir>$(MSBuildThisFileDirectory)..\inpctl\bin\$(Configuration)\net10.0\</InpctlBinDir>
    <UiactlBinDir>$(MSBuildThisFileDirectory)..\uiactl\bin\$(Configuration)\net10.0\</UiactlBinDir>
    <ScrcapBinDir>$(MSBuildThisFileDirectory)..\scrcap\bin\$(Configuration)\net10.0\</ScrcapBinDir>
    <TxtfndBinDir>$(MSBuildThisFileDirectory)..\txtfnd\bin\$(Configuration)\$(SiblingTfm)\</TxtfndBinDir>
    <WaitfrBinDir>$(MSBuildThisFileDirectory)..\waitfr\bin\$(Configuration)\$(SiblingTfm)\</WaitfrBinDir>
    <SpkbakBinDir>$(MSBuildThisFileDirectory)..\spkbak\bin\$(Configuration)\$(SiblingTfm)\</SpkbakBinDir>
  </PropertyGroup>

  <ItemGroup>
    <OutcapFiles Include="$(OutcapBinDir)**\*.*" />
    <InpctlFiles Include="$(InpctlBinDir)**\*.*" />
    <UiactlFiles Include="$(UiactlBinDir)**\*.*" />
    <TxtfndFiles Include="$(TxtfndBinDir)**\*.*" />
    <ScrcapFiles Include="$(ScrcapBinDir)**\*.*" />
    <WaitfrFiles Include="$(WaitfrBinDir)**\*.*" />
    <SpkbakFiles Include="$(SpkbakBinDir)**\*.*" />
  </ItemGroup>

  <Target Name="CopyOutcapToPlaybkOutput" AfterTargets="Build" Condition="Exists('$(OutcapBinDir)')">
    <Message Text="Copying outcap build outputs to playbk bin..." Importance="low" />
    <Copy SourceFiles="@(OutcapFiles)"
          DestinationFolder="$(OutputPath)\%(OutcapFiles.RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyInpctlToPlaybkOutput" AfterTargets="Build" Condition="Exists('$(InpctlBinDir)')">
    <Message Text="Copying inpctl build outputs to playbk bin..." Importance="low" />
    <Copy SourceFiles="@(InpctlFiles)"
          DestinationFolder="$(OutputPath)\%(InpctlFiles.RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyUiactlToPlaybkOutput" AfterTargets="Build" Condition="Exists('$(UiactlBinDir)')">
    <Message Text="Copying uiactl build outputs to playbk bin..." Importance="low" />
    <Copy SourceFiles="@(UiactlFiles)"
          DestinationFolder="$(OutputPath)\%(UiactlFiles.RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyTxtfndToPlaybkOutput" AfterTargets="Build" Condition="Exists('$(TxtfndBinDir)')">
    <Message Text="Copying txtfnd build outputs to playbk bin..." Importance="low" />
    <Copy SourceFiles="@(TxtfndFiles)"
          DestinationFolder="$(OutputPath)\%(TxtfndFiles.RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyScrcapToPlaybkOutput" AfterTargets="Build" Condition="Exists('$(ScrcapBinDir)')">
    <Message Text="Copying scrcap build outputs to playbk bin..." Importance="low" />
    <Copy SourceFiles="@(ScrcapFiles)"
          DestinationFolder="$(OutputPath)\%(ScrcapFiles.RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyWaitfrToPlaybkOutput" AfterTargets="Build" Condition="Exists('$(WaitfrBinDir)')">
    <Message Text="Copying waitfr build outputs to playbk bin..." Importance="low" />
    <Copy SourceFiles="@(WaitfrFiles)"
          DestinationFolder="$(OutputPath)\%(WaitfrFiles.RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopySpkbakToPlaybkOutput" AfterTargets="Build" Condition="Exists('$(SpkbakBinDir)')">
    <Message Text="Copying spkbak build outputs to playbk bin..." Importance="low" />
    <Copy SourceFiles="@(SpkbakFiles)"
          DestinationFolder="$(OutputPath)\%(SpkbakFiles.RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
