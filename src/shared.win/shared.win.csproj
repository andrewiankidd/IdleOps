<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows/WinRT-targeted shared library. Separate from `shared` (net10.0, which
    stays cross-platform for audcap/vidcap) because Windows.Media.Ocr requires the
    Windows SDK TFM. Home for logic that needs WinRT; CLIs (txtfnd) and playbk
    build on it so there is one implementation, not one per tool.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\shared.csproj" />
  </ItemGroup>

</Project>
