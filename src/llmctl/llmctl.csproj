<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Thin agent client: talks to any OpenAI-compatible chat endpoint (Ollama, vLLM,
    LM Studio, ...). No model runtime here — the model runs externally on the GPU.
    This is the optional "brain" that the other IdleOps tools are the hands for.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="llmctl.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>

</Project>
