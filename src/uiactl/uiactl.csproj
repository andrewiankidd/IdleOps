<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="uiactl.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\shared.csproj" />
  </ItemGroup>

  <!--
    The Linux AT-SPI backend shells out to this pyatspi helper. Embedded rather than copied
    beside the binary so uiactl publishes as a single executable; LinuxUiAutomation unpacks
    it to a temp path on first use. LogicalName pins the resource id the code looks up.
  -->
  <ItemGroup>
    <EmbeddedResource Include="atspi_helper.py" LogicalName="uiactl.atspi_helper.py" />
  </ItemGroup>

</Project>
